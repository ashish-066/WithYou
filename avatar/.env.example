# ============================================
# Environment
# ============================================
# development | staging | production
# In production the API and agent refuse to start if a required key is missing.
ENVIRONMENT=development

# ============================================
# Redis Configuration
# ============================================
# Production: Redis must require a password (and use TLS when it is on another
# host): redis://:<password>@host:6379/0 or rediss://:<password>@host:6380/0
REDIS_URL=redis://localhost:6379/0

# Postgres (accounts, invites, roles, interview records and reports).
# Development default: the local container (see docs/BACKUPS.md / launch log):
#   docker run -d --name alex-postgres -e POSTGRES_USER=alex \
#     -e POSTGRES_PASSWORD=alex-dev-password -e POSTGRES_DB=alex \
#     -p 127.0.0.1:5434:5432 -v alex-pgdata:/var/lib/postgresql/data postgres:16-alpine
# Required in production; run `python -m alex_db.migrate` before deploying.
# DATABASE_URL=postgresql://alex:alex-dev-password@127.0.0.1:5434/alex

# Stream Configuration (must match the worker)
REQUEST_STREAM=interview:requests
RESPONSE_STREAM=interview:responses

# ============================================
# Server Configuration
# ============================================
HOST=0.0.0.0
PORT=8001
DEBUG=false

# Listener Configuration
CONSUME_BATCH_SIZE=10
CONSUME_BLOCK_MS=5000
IDLE_CLAIM_MS=30000

# ============================================
# LiveKit Configuration
# ============================================
# Get these from your LiveKit Cloud project or self-hosted server
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# ============================================
# BeyondPresence Configuration
# ============================================
# Get your API key from https://app.bey.chat/settings
BEY_API_KEY=your-bey-api-key

# Avatar ID (default is a professional female avatar)
# Find more avatars at https://app.bey.chat/avatars
BEY_AVATAR_ID=b9be11b8-89fb-4227-8f86-4a881393cbdb

# ============================================
# Speech (required by the LiveKit agent)
# ============================================
# The agent calls the Deepgram (speech-to-text) and Cartesia (text-to-speech)
# plugins directly, so both keys are required.
DEEPGRAM_API_KEY=your-deepgram-api-key
CARTESIA_API_KEY=your-cartesia-api-key

# ============================================
# Recording storage (S3 or S3-compatible)
# ============================================
# Without these, interview recording fails (the call itself continues).
# S3_ENDPOINT is only needed for non-AWS providers.
# S3_ENDPOINT=
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET=presence-view-recordings
S3_REGION=eu-north-1

# ============================================
# Agent Configuration
# ============================================
AGENT_NAME=Presence
AGENT_INSTRUCTIONS="You are Presence, a professional AI interviewer conducting a job interview. You are warm, professional, and encouraging while maintaining high standards. Keep your responses concise (2-3 sentences) to maintain natural conversation flow. Ask follow-up questions to understand the candidate's experience deeply. Never use markdown, bullet points, or special formatting - speak naturally."

# ============================================
# Auth
# ============================================
# Signs login cookies and invite links. Required in production (32+ random
# characters), e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Changing it signs everyone out and invalidates unused invite links.
AUTH_SECRET=
# Public sign-up (creates a new organization). Defaults: on in development,
# off in production. Create accounts with `uv run python -m scripts.create_user`.
# ALLOW_SIGNUP=false
# Browser origins allowed to call the API with cookies (comma-separated)
CORS_ORIGINS=http://localhost:3000
# Scalability demo endpoints (platform admins only). Default: off in production.
# ENABLE_DEMO=false
# Reverse proxies in front of the API that append to X-Forwarded-For (used for
# the client IP in rate limits). 0 = none (local dev); frontend nginx = 1;
# nginx behind a cloud load balancer = 2. Too high lets clients forge their IP.
# TRUSTED_PROXY_HOPS=0

# LiveKit agent (`python -m agents.entrypoint start`): on SIGTERM it takes no new
# interviews and waits up to this long for running ones (stop grace period must
# be longer). Health check: GET http://<agent>:AGENT_HEALTH_PORT/
# AGENT_DRAIN_TIMEOUT_SECONDS=3600
# AGENT_HEALTH_PORT=8081
