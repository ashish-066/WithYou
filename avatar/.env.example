# WithYou API + voice agent. Copy to .env and fill in.

ENVIRONMENT=development
REDIS_URL=redis://localhost:6379/0
# Empty in development = the local docker Postgres on 127.0.0.1:5434
DATABASE_URL=
HOST=0.0.0.0
PORT=8001
DEBUG=false

# LiveKit Cloud (livekit.io): real-time audio/video
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
# Name the voice agent registers under (one per LiveKit project)
AGENT_DISPATCH_NAME=padippu-buddy

# Sarvam (sarvam.ai): speech-to-text (Saaras), voice (Bulbul v3), translation
SARVAM_API_KEY=your-sarvam-api-key
VOICE_PROVIDER=sarvam
TTS_SPEAKER=kavya

# Google Gemini: reads photographed textbook pages
GOOGLE_API_KEY=your-google-api-key

# BeyondPresence (bey.dev): optional video face. Without it (or if it fails)
# conversations continue voice-only with the animated companion.
ENABLE_AVATAR=true
BEY_API_KEY=your-bey-api-key

# Optional English-only fallback voice (VOICE_PROVIDER=deepgram)
DEEPGRAM_API_KEY=

BUDDY_LANGUAGE=ml-IN

# Sign-in cookies: 32+ random characters in production (openssl rand -hex 32)
AUTH_SECRET=
CORS_ORIGINS=http://localhost:3000
# Sign-up is on in development; set true to allow it in production
ALLOW_SIGNUP=
