# Rendered at container start by the nginx image (envsubst replaces only the
# variables set in the environment: ${API_UPSTREAM}, ${CSP_CONNECT_SRC}).
# TLS terminates at the load balancer / CDN in front of this container.

map $uri $alex_cache_control {
    ~^/assets/  "public, max-age=31536000, immutable";  # hashed file names
    ~^/api/     "";                                     # the API sets its own
    default     "no-cache";                             # index.html: always revalidate
}

server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;

    client_max_body_size 10m; # photos of textbook pages

    # Security headers (no add_header inside locations: it would drop these)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(self), display-capture=(), geolocation=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ${CSP_CONNECT_SRC}; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
    add_header Cache-Control $alex_cache_control always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Same-origin API: /api/x -> ${API_UPSTREAM}/x (as the Vite dev proxy does)
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # Server-sent events (ops dashboard) must not be buffered
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    # Single-page app: unknown paths serve index.html
    location / {
        try_files $uri /index.html;
    }
}
