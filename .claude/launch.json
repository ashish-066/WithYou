{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "avatar",
        "--frozen",
        "python",
        "main.py"
      ],
      "port": 8001
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_PROXY_TARGET=http://localhost:8003",
        "PORT=3002",
        "npm",
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3002
    }
  ]
}