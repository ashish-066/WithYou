# ============================================
# Brain Worker configuration
# Copy to .env and fill in. Never commit .env.
# ============================================

# development | staging | production
# In production the worker refuses to start if a required key below is missing.
ENVIRONMENT=development

# Redis (must be the same instance as the avatar service)
# Production: Redis must require a password (and use TLS when it is on another
# host): redis://:<password>@host:6379/0 or rediss://:<password>@host:6380/0
REDIS_URL=redis://localhost:6379/0

# Postgres (accounts, invites, roles, interview records and reports).
# Development default: the local container (see docs/BACKUPS.md / launch log):
#   docker run -d --name alex-postgres -e POSTGRES_USER=alex \
#     -e POSTGRES_PASSWORD=alex-dev-password -e POSTGRES_DB=alex \
#     -p 127.0.0.1:5434:5432 -v alex-pgdata:/var/lib/postgresql/data postgres:16-alpine
# Required in production; run `python -m alex_db.migrate` before deploying.
# DATABASE_URL=postgresql://alex:alex-dev-password@127.0.0.1:5434/alex

# Optional: stable worker id (defaults to a random 8-char id).
# Also sets the Redis consumer name to worker-<WORKER_ID>.
# WORKER_ID=w1

# ============================================
# LLM (required)
# ============================================
# Google Gemini key; GEMINI_API_KEY is accepted as an alias.
GOOGLE_API_KEY=your-google-api-key

# ============================================
# Tools (optional - features degrade without them)
# ============================================
# Web search during interviews
TAVILY_API_KEY=your-tavily-api-key
# GitHub profile crawling (raises GitHub API rate limits)
GITHUB_TOKEN=your-github-token
# LinkedIn profile data
PROXYCURL_API_KEY=your-proxycurl-api-key
# Hume emotion/expression analysis of the recording
HUME_API_KEY=your-hume-api-key
# HUME_CALLBACK_URL=https://your-domain/hume/callback

# ============================================
# Tuning (defaults are fine for development)
# ============================================
DEBUG=false
# LOCK_TTL_MS=5000
# RECLAIM_INTERVAL_SECONDS=15
# RECLAIM_MIN_IDLE_MS=30000
# MAX_DELIVERY_ATTEMPTS=3

# ============================================
# DSA code sandbox
# ============================================
# docker: each test runs in a throwaway locked-down container (no network,
#   no host files, non-root, memory/CPU/process limits). Required in production.
#   Needs a Docker daemon (on macOS: `colima start`) and `docker pull python:3.12-slim`.
# subprocess: plain local process, NOT isolated. Development only.
SANDBOX_MODE=subprocess
# Production requires a digest pin; the image docker-compose.yml uses:
# SANDBOX_IMAGE=python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159
# DOCKER_HOST=tcp://sandbox-host:2376   # the isolated daemon that runs candidate code
# SANDBOX_RUNTIME=runsc                             # gVisor, if installed on the host
# SANDBOX_MEMORY_MB=256
# SANDBOX_MAX_CONCURRENCY=8
