# WithYou companion brain (worker). Copy to .env and fill in.

ENVIRONMENT=development
REDIS_URL=redis://localhost:6379/0
# Empty in development = the local docker Postgres on 127.0.0.1:5434
DATABASE_URL=

# Sarvam (sarvam.ai): Sarvam-105B writes the replies
SARVAM_API_KEY=your-sarvam-api-key
FAST_LLM_PROVIDER=sarvam
SARVAM_LLM_MODEL=sarvam-105b

# Google Gemini: fallback model and the slower recap/assessment steps
GOOGLE_API_KEY=your-google-api-key

# Language a session starts in when none was chosen: ml-IN | te-IN | ta-IN | hi-IN | en-IN
BUDDY_LANGUAGE=ml-IN
DEBUG=false
